# 一键 Get 环境变量配置
# 复制此文件为 .env 并填入真实值，或在部署平台（如 Sudo AI）的环境变量中配置

# 服务端口
PORT=8080

# 站点 URL（用于 OAuth 回调地址拼接）
SITE_URL=http://localhost:8080

# ============ 微信开放平台登录 ============
# 申请地址：https://open.weixin.qq.com
# 需要：网站应用审核通过，获得 AppID 和 AppSecret
# 回调地址需在微信开放平台后台配置为：{SITE_URL}/api/auth/wechat/callback
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 可选：自定义回调地址，不填则自动拼接
WECHAT_REDIRECT_URI=

# ============ QQ 互联登录 ============
# 申请地址：https://connect.qq.com
# 需要：网站应用审核通过，获得 App ID 和 App Key
# 回调地址需在 QQ 互联后台配置为：{SITE_URL}/api/auth/qq/callback
QQ_APP_ID=
QQ_APP_SECRET=
# 可选：自定义回调地址，不填则自动拼接
QQ_REDIRECT_URI=
